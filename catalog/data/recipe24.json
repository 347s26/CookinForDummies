{
    "title": "Crunchy Greens with Carrot-Ginger Dressing",
    "description": "Crisp salad with a blended carrot-ginger Japanese-style dressing.",
    "ingredients": [
      { "name": "carrot", "quantity": "1 small, chopped" },
      { "name": "ginger", "quantity": "1 inch piece, chopped" },
