      { "name": "onion powder", "quantity": "1 teaspoon" },
      { "name": "lettuce", "quantity": "1 head" },
      { "name": "mint", "quantity": "1 cup" }
    ],
    "steps": [
      { "order": 1, "instruction": "Blend carrot, ginger, oil, vinegar, soy sauce, sugar, and seasoning until smooth." },
      { "order": 2, "instruction": "Toss lettuce with dressing lightly." },
